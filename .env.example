# Public configuration only; never put passwords or session tokens here.
CIRCULAR_PUBLIC_URL=https://circular.example.epita.fr
CIRCULAR_IMAGE_TAG=2.0.0
CIRCULAR_BIND_ADDRESS=127.0.0.1
CIRCULAR_HTTP_PORT=4310
CIRCULAR_SECRETS_DIR=./secrets
# Exact proxy IP/CIDR only. Do not use *; otherwise client addresses can be spoofed.
CIRCULAR_TRUSTED_PROXIES=127.0.0.1
